{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-vim",
  "version": "0.0.28",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tarquinen/opencode-vim"
  },
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,tsx}\" tui.tsx",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,tsx}\" tui.tsx",
    "test": "bun test --conditions=browser --preload @opentui/solid/preload ./test/unit ./test/integration",
    "test:e2e": "bun test/e2e/run.ts",
    "bench": "bun test/benchmark.ts"
  },
  "dependencies": {
    "@vimee/core": "^0.3.0",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.10",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.10",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0"
  },
  "files": [
    "assets/",
    "docs/",
    "dist/",
    "README.md"
  ]
}
