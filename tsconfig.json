{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": ["./tui.tsx", "./src/**/*.ts", "./src/**/*.tsx", "./scripts/**/*.ts", "./test/**/*.ts", "./test/**/*.tsx"]
}
